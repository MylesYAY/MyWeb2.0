{
  "name": "myweb",
  "version": "1.2.0",
  "description": "Google-inspired Wikipedia search with deep-linkable queries and desktop packaging.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:web": "python -m http.server 8000",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.myweb.desktop",
    "productName": "MyWeb",
    "artifactName": "MyWeb-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "script.js",
      "styles.css",
      "main.js",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "electron": "^28.3.1",
    "electron-builder": "^24.13.3"
  }
}
